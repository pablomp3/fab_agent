# Server-side keys. Never commit .env or a real key. The browser never sees them.
NEBIUS_API_KEY=

# Tavily research: public troubleshooting leads on inconclusive, contradictory,
# or unknown-machine results. Leads never change the Python gate.
TAVILY_API_KEY=

