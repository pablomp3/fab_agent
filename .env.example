# Copy to .env for local live runs. Never commit .env or a real key.
# The server reads these values; the browser never receives them.
NEBIUS_API_KEY=

# Optional: enables bounded Tavily external references on inconclusive or
# experimental runs. These references never change the Python gate.
TAVILY_API_KEY=

# Optional: override the configured SYNTHESIS model.
# FABAGENT_SYNTHESIS_MODEL=nvidia/Nemotron-3_5-Lightning
